# Esnaf Randevu Asistanı — ortam değişkenleri (isteğe bağlı)
# Bu dosyayı .env olarak kopyalayıp düzenleyebilirsiniz.
# .env dosyası .gitignore içindedir; şifreler commit edilmez.

# Panel yalnızca bu bilgisayardan erişilebilir olsun:
ESNAF_HOST=127.0.0.1
ESNAF_PORT=5000

# Panel giriş parolası. Boşsa giriş istenmez (yalnızca 127.0.0.1 için uygundur).
# ESNAF_HOST yerel ağ adresiyse (ör. 0.0.0.0) parola ZORUNLUDUR.
# ESNAF_PASSWORD=guclu-bir-parola

# Panelin kabul ettiği Host başlıkları (DNS rebinding koruması).
# LAN'a açacaksanız bilgisayarın IP'sini de ekleyin: 192.168.1.20,localhost
# ESNAF_TRUSTED_HOSTS=127.0.0.1,localhost

# Veritabanı ve veri klasörü (varsayılan: proje içindeki data/)
# ESNAF_DATA_DIR=C:\esnafspor\data
# ESNAF_DB=C:\esnafspor\data\esnaf.db

# Motorun SQLite kontrol sıklığı (saniye, en az 5)
ESNAF_WORKER_INTERVAL=30

# HTTP WhatsApp ağ geçidi kullanıyorsanız API anahtarını burada tutabilirsiniz
# (Ayarlar sayfasındaki alan boşsa bu değer kullanılır)
# ESNAF_HTTP_TOKEN=degistirin

# Günlük otomatik yedeklerin klasörü (varsayılan: data/backups).
# Bilgisayar bozulursa kaybolmasın diye USB disk veya OneDrive klasörü önerilir.
# ESNAF_BACKUP_DIR=D:\esnaf-yedek

# Günlük dosyaları (varsayılan: data/logs)
# ESNAF_LOG_DIR=C:\esnafspor\data\logs
